# Web frontend. Use the local publishable key printed by supabase status.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=your-local-publishable-key

# Local Supabase Google OAuth (server-side only; use a separate development client)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your-development-client.apps.googleusercontent.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=your-development-client-secret
